<VBox fx:id="theBox" alignment="CENTER" onKeyPressed="#onKeyPressed" prefHeight="800.0" prefWidth="739.0" stylesheets="@general.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csc.paradise.piper.scrapefall.controllers.MainController">
   <Pane fx:id="test" prefHeight="800.0" prefWidth="679.0">
       <children>
         <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="800.0" stroke="BLACK" strokeLineJoin="ROUND" styleClass="homepage-rectangle" width="739.0" />
         <ScrollPane fx:id="cardScrollPane" hbarPolicy="NEVER" maxHeight="630.0" maxWidth="495.0" minHeight="630.0" minWidth="480.0" prefHeight="630.0" prefWidth="495.0" style="-fx-background-color: black;" vbarPolicy="ALWAYS">
            <content>
               <TilePane fx:id="cardPaneContainer" maxWidth="481.0" minWidth="480.0" prefHeight="630.0" prefWidth="481.0" styleClass="pane-background" />
            </content>
         </ScrollPane>
         <Label fx:id="cardsErrorLabel" alignment="CENTER" focusTraversable="false" layoutX="2.0" layoutY="243.0" mouseTransparent="true" prefHeight="98.0" prefWidth="466.0" textFill="RED">
            <font>
               <Font size="32.0" />
            </font>
         </Label>
         <ScrollPane hbarPolicy="NEVER" layoutX="509.0" layoutY="59.0" prefHeight="605.0" prefWidth="200.0" vbarPolicy="NEVER">
