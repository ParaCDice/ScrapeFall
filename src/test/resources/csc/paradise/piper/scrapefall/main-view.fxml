         <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#cfcfcf" height="34.0" layoutX="509.0" layoutY="672.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="200.0" />
